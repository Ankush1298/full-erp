# Copy to .env (never commit .env). infrastructure/scripts/setup-dev.sh does this and
# generates a random database password for you. Values below are placeholders only.

NODE_ENV=development
HOST=127.0.0.1
PORT=4000
LOG_LEVEL=info

# PostgreSQL (dev: docker compose or `pnpm dev:db`). Three DIFFERENT identities, three passwords.
#  - DATABASE_URL            app_runtime   : the ONLY credential the running application uses
#  - MIGRATION_DATABASE_URL  app_migrator  : schema owner, used by `pnpm db:migrate` only (never loaded by the app)
#  - DATABASE_ADMIN_URL      superuser     : used by `pnpm db:bootstrap` / dev:db / tests only (dev, CI; never in production app config)
DATABASE_URL=postgresql://app_runtime:change_me_runtime@127.0.0.1:54329/campusos_dev
MIGRATION_DATABASE_URL=postgresql://app_migrator:change_me_migrator@127.0.0.1:54329/campusos_dev
DATABASE_ADMIN_URL=postgresql://campusos_admin:change_me_admin@127.0.0.1:54329/campusos_dev
DATABASE_SSL=disable
DATABASE_POOL_MAX=10

# CSRF origin allow-list: comma-separated EXACT browser origins that may send state-changing requests.
# Required (https only) when NODE_ENV=production. Leave empty in development to allow same-host only.
APP_ORIGINS=

# Only set to true when running behind a trusted reverse proxy that sets X-Forwarded-*.
TRUST_PROXY=false

# docker compose (infrastructure/docker/docker-compose.yml) reads this; keep it equal to the password in DATABASE_URL.
POSTGRES_PASSWORD=change_me_admin

# TOTP MFA secret encryption (docs/runbooks/secrets.md "MFA encryption keys"). REQUIRED when NODE_ENV=production.
# Both or neither; a dedicated key, never a CURSOR_KEYS key. Generate one per environment, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Left commented here on purpose: an EMPTY value is a startup error. Without them (outside production) MFA enrollment
# answers 503, and users in MFA-required roles (HOD and above, REGISTRAR) cannot leave the restricted session.
# MFA_ENCRYPTION_KEYS=<keyId>:<43-character base64url key>
# MFA_ENCRYPTION_ACTIVE_KEY_ID=<keyId>

# Import matching-data HMAC keys (docs/runbooks/secrets.md "Import matching-data keys"). REQUIRED when NODE_ENV=production.
# Both or neither; a dedicated key, never a CURSOR_KEYS or MFA_ENCRYPTION_KEYS key. Same format and generation as above.
# Left commented on purpose (an EMPTY value is a startup error). Without them (outside production) a student import commit
# that carries date-of-birth or guardian-phone data answers 503 IMPORT_MATCHING_UNAVAILABLE; imports without them still work.
# IMPORT_MATCHING_KEYS=<keyId>:<43-character base64url key>
# IMPORT_MATCHING_ACTIVE_KEY_ID=<keyId>
